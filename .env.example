# Environment Variables Template for TripWiser

# Supabase Configuration (REQUIRED for Auth)
NUXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NUXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here # Settings > API > service_role key

# Geoapify API Key
NUXT_GEOAPIFY_API_KEY=your_geoapify_api_key

# Google Gemini API
GOOGLE_AI_API_KEY=your_google_ai_api_key_here # Get it from https://aistudio.google.com/app/apikey

# Mapbox Access Token (for destination images)
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here # Get it from https://account.mapbox.com/access-tokens/
